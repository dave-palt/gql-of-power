{
	"name": "@dav3/gql-of-power",
	"version": "1.8.0-dev",
	"description": "Generate a single optimized SQL query from GraphQL operations — eliminate N+1 with recursive field-to-SQL mapping. Ships with agent skill for AI coding assistants.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"module": "esnext",
	"repository": {
		"url": "https://github.com/dave-palt/gql-of-power",
		"directory": "gql-of-power",
		"type": "git"
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc --watch",
		"prepublishOnly": "bun run build",
		"test": "D3GOP_LOG_TYPE=\"disabled\" bun test",
		"test:unit": "D3GOP_LOG_TYPE=\"disabled\" bun test --filter='unit'",
		"test:integration": "D3GOP_LOG_TYPE=\"disabled\" bun test --filter='integration'",
		"test:watch": "D3GOP_LOG_TYPE=\"disabled\" bun test --watch",
		"test:coverage": "D3GOP_LOG_TYPE=\"disabled\" bun test --coverage",
		"format": "bunx prettier --write .",
		"format:check": "bunx prettier --check .",
		"typecheck": "tsc --noEmit",
		"precommit": "bun run format && bun run typecheck && bun run test",
		"audit": "fallow audit",
		"audit:full": "fallow",
		"audit:dead-code": "fallow dead-code",
		"audit:dupes": "fallow dupes",
		"audit:health": "fallow health",
		"audit:fix": "fallow fix"
	},
	"keywords": [
		"graphql",
		"sql",
		"type-graphql",
		"n-plus-1",
		"agent-skill",
		"claude-code",
		"cursor",
		"orm"
	],
	"author": "",
	"license": "MIT NON-AI License",
	"devDependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/aws-lambda": "^4.1.0",
		"@graphql-tools/schema": "^10.0.38",
		"@types/bun": "latest",
		"@types/graphql-fields": "^1.3.9",
		"fallow": "^3.6.0",
		"graphql-yoga": "^5.21.0",
		"reflect-metadata": "^0.2.2",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"graphql": "^16.14.0",
		"graphql-fields": "^2.0.3",
		"graphql-parse-resolve-info": "^4.14.1",
		"knex": "^3.2.10",
		"type-graphql": "^2.0.0-rc.4"
	},
	"workspaces": [
		"examples/*"
	]
}
